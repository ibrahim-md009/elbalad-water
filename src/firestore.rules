rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // المسؤول = وجود وثيقة admins/{uid} (تُنشأ يدويًا من Firebase Console)
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // رقم الأسبوع (يبدأ السبت 00:00 بتوقيت UTC+2) — مطابق لـ src/lib/week.js
    function weekIdx(ts) {
      return math.floor((math.floor((ts.toMillis() + 7200000) / 86400000) + 5) / 7);
    }

    // إعدادات الموقع (settings/general). إن لم تُنشأ الوثيقة بعد نرجع خريطة فارغة
    // بدل أن ترفض القواعد كل عملية (وكانت سبب «ليست لديك صلاحية» عند التسجيل).
    function siteSettings() {
      let path = /databases/$(database)/documents/settings/general;
      return exists(path) ? get(path).data : {};
    }

    // دقائق العميل المستهلكة قبل هذه العملية (تُصفَّر إن بدأ أسبوع جديد)
    function usedBefore(c) {
      return (c.get('lastBookingAt', null) is timestamp
              && weekIdx(c.lastBookingAt) == weekIdx(request.time))
        ? c.get('weekMinutes', 0) : 0;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ───────── availability ─────────
    // القراءة عامة (الموقع الأساسي يعرض الدقائق المتاحة).
    // الزبون يستطيع فقط خصم دقائق (لا يزيدها ولا يغيّر الإجمالي) — وتتم العملية داخل Transaction.
    match /availability/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isCustomerDeduction();

      function isCustomerDeduction() {
        let before = resource.data;
        let after = request.resource.data;
        return after.diff(before).affectedKeys()
                 .hasOnly(['availableMinutes', 'reservedMinutes', 'status', 'updatedAt'])
          && after.availableMinutes is int
          && after.availableMinutes >= 0
          && after.availableMinutes < before.availableMinutes
          && after.reservedMinutes ==
               before.reservedMinutes + (before.availableMinutes - after.availableMinutes);
      }
    }

    // ───────── customers (العملاء والحد الأسبوعي بالدقائق) ─────────
    // معرّف الوثيقة = رقم الهاتف الموحّد (أرقام فقط).
    // قراءة وثيقة واحدة (get) متاحة للموقع ليعرف العميل حدّه، أما قائمة العملاء (list) فللمسؤول فقط.
    // الزبون لا يحدد حدّه أبدًا: يُنشأ بالحد الافتراضي، ولا يستطيع بعدها إلا زيادة دقائقه المستهلكة
    // بمقدار دقائق الحجز داخل نفس العملية التي تُنشئه، وبشرط ألا يتجاوز الحد (بالدقائق).
    match /customers/{cid} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin() || isValidCustomerCreate(cid);
      allow update: if isAdmin() || isCustomerBump();
      allow delete: if isAdmin();

      function isValidCustomerCreate(custId) {
        let a = request.resource.data;
        let settings = siteSettings();
        return a.keys().hasOnly(['name', 'phone', 'weeklyMinutes', 'blocked', 'weekMinutes',
                                 'createdAt', 'updatedAt'])
          && a.keys().hasAll(['name', 'phone', 'weeklyMinutes', 'blocked', 'weekMinutes',
                              'createdAt', 'updatedAt'])
          && a.phone == custId
          && a.phone.matches('[0-9]{7,15}')
          && a.name is string && a.name.size() > 0 && a.name.size() <= 100
          && a.weeklyMinutes == settings.get('defaultWeeklyMinutes', 60)
          && a.blocked == false
          && a.weekMinutes == 0
          && a.createdAt == request.time
          && a.updatedAt == request.time;
      }

      function isCustomerBump() {
        let b = resource.data;
        let a = request.resource.data;
        let settings = siteSettings();
        let limit = b.get('weeklyMinutes', settings.get('defaultWeeklyMinutes', 60));
        return a.diff(b).affectedKeys().hasOnly(['weekMinutes', 'lastBookingAt', 'updatedAt'])
          && b.blocked == false
          && a.lastBookingAt == request.time
          && a.updatedAt == request.time
          && a.weekMinutes is int
          && a.weekMinutes > usedBefore(b)
          && a.weekMinutes <= limit;
      }
    }

    // ───────── reservations ─────────
    // بيانات الزبائن (الهاتف، الوصل) للمسؤول فقط.
    // الزبون يستطيع إنشاء طلب pending فقط، بشرط أن يُخصم نفس العدد من الدقائق في نفس العملية.
    // عندما يكون settings/general.requireCustomer = true يُشترط أيضًا أن يكون الزبون مسجّلًا
    // وأن تُزاد دقائقه الأسبوعية (بمقدار دقائق الحجز وضمن حدّه) في نفس العملية.
    match /reservations/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || isValidCustomerReservation();

      function customerOk(d, settings) {
        let cPath = /databases/$(database)/documents/customers/$(d.phone);
        return !settings.get('requireCustomer', false)
          || (exists(cPath)
              && getAfter(cPath).data.lastBookingAt == request.time
              && getAfter(cPath).data.weekMinutes == usedBefore(get(cPath).data) + d.minutes);
      }

      function isValidCustomerReservation() {
        let d = request.resource.data;
        let settings = siteSettings();
        let availPath = /databases/$(database)/documents/availability/$(d.availabilityId);
        return d.keys().hasOnly(['name', 'phone', 'minutes', 'price', 'minutesPerCup',
                                 'pricePerCup', 'availabilityId', 'dateText', 'notes',
                                 'receiptUrl', 'status', 'createdAt'])
          && d.keys().hasAll(['name', 'phone', 'minutes', 'price', 'availabilityId',
                              'status', 'createdAt'])
          && d.status == 'pending'
          && d.createdAt == request.time
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.phone is string && d.phone.size() >= 5 && d.phone.size() <= 20
          && d.minutes is int && d.minutes > 0
          && d.price is number
          && math.abs(d.price - (d.minutes * settings.get('pricePerCup', 10) / settings.get('minutesPerCup', 20))) < 0.01
          && getAfter(availPath).data.availableMinutes ==
               get(availPath).data.availableMinutes - d.minutes
          && customerOk(d, settings);
      }
    }

    // ───────── expenses (المصروفات) — للمسؤول فقط ─────────
    match /expenses/{id} {
      allow read, write: if isAdmin();
    }

    // ───────── paymentMethods ─────────
    match /paymentMethods/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ───────── settings ─────────
    // settings/general عامة القراءة (الأسعار)، أما counters فللمسؤول فقط.
    match /settings/{id} {
      allow read: if id == 'general' || isAdmin();
      allow write: if isAdmin();
    }
  }
}
